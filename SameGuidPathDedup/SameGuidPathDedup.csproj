<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <TargetFramework></TargetFramework>
    <RootNamespace>SameGuidPathDedup</RootNamespace>
    <AssemblyName>SameGuidPathDedup</AssemblyName>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0</Version>
    <NoWarn>1591</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!--
      SDK auto-generates AssemblyInfo with the assembly title/version/etc., but
      the auto-generated file would conflict with our Properties/AssemblyInfo.cs
      (which only carries the Emby-plugin Guid). Turn it off so the only source
      is Properties/AssemblyInfo.cs.
    -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediaBrowser.Server.Core" Version="4.9.1.90" />
    <!--
      MediaBrowser.Model 4.9.1.90 references System.Memory 4.0.2.0; the SDK
      does not propagate it transitively in netstandard2.0 builds. System.Memory
      4.5.4 ships the 4.0.2.0 assembly; earlier versions ship 4.0.1.x.
    -->
    <PackageReference Include="System.Memory" Version="4.5.5" />
  </ItemGroup>

</Project>